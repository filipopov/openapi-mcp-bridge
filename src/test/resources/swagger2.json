{
  "swagger": "2.0",
  "info": { "title": "Swagger 2 sample", "version": "1.0" },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "paths": {
    "/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "operationId": "deleteUser",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "204": { "description": "deleted" } }
      }
    }
  }
}
